#!/bin/bash
# Telegram notice at boot. OPNsense is a VM on this same host, so internet comes up
# only after it has started: retry every 15 s for up to 15 minutes.
BOOT=$(date -d "$(uptime -s)" '+%H:%M del %d/%m')
for _ in {1..60}; do
  ONLINE=$(cut -d. -f1 /proc/uptime)
  if /usr/local/bin/tg-notify "🔄 avviato alle ${BOOT}, kernel $(uname -r), online dopo ${ONLINE} s"; then
    exit 0
  fi
  sleep 15
done
echo "no internet after 15 minutes: boot notice not sent" >&2
exit 1
