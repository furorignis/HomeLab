#!/bin/bash
# Usage: tg-notify "message"  ->  sends "[hostname] message" to Telegram.
# Token and chat ID reach curl through a config read from stdin (-K -), so they
# never appear in the process list (/proc/<pid>/cmdline is readable by every user).
# printf is a bash builtin: no process ever has the token in its arguments.
set -u
# shellcheck source=/dev/null
. /etc/homelab/telegram.env
printf 'url = "https://api.telegram.org/bot%s/sendMessage"\ndata-urlencode = "chat_id=%s"\n' \
  "$TG_TOKEN" "$TG_CHAT" |
  curl -fsS -m 15 -K - --data-urlencode "text=[$(hostname -s)] $*" >/dev/null
