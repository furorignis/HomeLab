#!/usr/bin/env python3
# OPNsense check, every minute (opnsense-check.timer); Telegram alerts via tg-notify:
# - outage (VM stopped, API silent, PPPoE without IP, gateway down): the start time is
#   saved even if the alert cannot be sent, and the recovery message reports the duration;
# - PPPoE reconnection: public IP changed (only its SHA-256 hash is stored on disk);
# - gateway degraded according to dpinger: alert only on state changes.
# Telegram messages are in Italian on purpose; everything else is in English.
# Tests: OPNSENSE_CHECK_STATE and OPNSENSE_CHECK_VMID override the state directory and
# the VM ID (a VM that does not exist simulates an outage without touching the router).
import hashlib, json, os, subprocess, time

STATE = os.environ.get('OPNSENSE_CHECK_STATE', '/var/lib/opnsense-check')
VMID = os.environ.get('OPNSENSE_CHECK_VMID', '100')
ENV = '/etc/homelab/opnsense.env'
API = 'https://10.99.0.1/api'   # MGMT network (isolated vmbr1 bridge), self-signed certificate: curl -k
GW, WAN = 'WAN_PPPOE', 'wan'

def run(cmd, inp=None):
    return subprocess.run(cmd, input=inp, capture_output=True, text=True, timeout=30)

def notify(msg):
    return run(['/usr/local/bin/tg-notify', msg]).returncode == 0

def cred():
    # KEY=value, KEY='value' or KEY="value": the same forms bash accepts in tg-notify
    d = {}
    for line in open(ENV):
        line = line.strip()
        if not line or line.startswith('#'): continue
        k, _, v = line.partition('=')
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"): v = v[1:-1]
        d[k.strip()] = v
    return d

def api(path, c):
    # credentials passed on stdin (-K -): they never appear in ps
    r = run(['curl', '-skf', '-m', '10', '-K', '-', f'{API}/{path}'],
            inp=f'user = "{c["OPN_KEY"]}:{c["OPN_SECRET"]}"\n')
    try: return json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError: return None

def rows(d):
    return d if isinstance(d, list) else (d.get('items') or d.get('rows') or [])

def load(name):
    try:
        with open(f'{STATE}/{name}') as f: return json.load(f)
    except (OSError, ValueError): return None

def save(name, value):
    with open(f'{STATE}/{name}.tmp', 'w') as f: json.dump(value, f)
    os.replace(f'{STATE}/{name}.tmp', f'{STATE}/{name}')

def drop(name):
    try: os.remove(f'{STATE}/{name}')
    except FileNotFoundError: pass

def fmt_time(t): return time.strftime('%H:%M del %d/%m', time.localtime(t))

def fmt_period(a, b):
    # Telegram text (Italian): same day "dalle 01:15 alle 01:18 del 25/10", otherwise full dates
    if time.strftime('%d/%m', time.localtime(a)) == time.strftime('%d/%m', time.localtime(b)):
        return f"dalle {time.strftime('%H:%M', time.localtime(a))} alle {fmt_time(b)}"
    return f'dalle {fmt_time(a)} alle {fmt_time(b)}'

def fmt_duration(s):
    s = int(s); h, r = divmod(s, 3600); m, s = divmod(r, 60)
    return f'{h} h {m} min' if h else (f'{m} min {s} s' if m else f'{s} s')

os.makedirs(STATE, exist_ok=True)
now, cause, gw, wan = time.time(), None, None, None
if 'status: running' not in run(['qm', 'status', VMID]).stdout:
    cause = 'VM OPNsense non in esecuzione'
else:
    c = cred()
    gws, ifs = api('routes/gateway/status', c), api('interfaces/overview/interfacesInfo', c)
    if gws is None or ifs is None:
        cause = "l'API di OPNsense non risponde"
    else:
        gw = next((g for g in rows(gws) if g.get('name') == GW), None)
        wan = next((i for i in rows(ifs) if i.get('identifier') == WAN), None)
        if gw is None or wan is None:
            cause = f'{GW} o interfaccia {WAN} assenti nella risposta API'
        elif wan.get('status') != 'up' or not wan.get('addr4'):
            cause = 'PPPoE non connesso'
        elif gw.get('status') in ('down', 'force_down'):
            cause = f"gateway WAN giù ({gw.get('status_translated')})"

outage = load('outage')
if cause:
    if outage is None:
        outage = {'start': now, 'cause': cause, 'notified': False}
        save('outage', outage)
    if not outage['notified'] and notify(f"⚠️ {outage['cause']} (dalle {fmt_time(outage['start'])})"):
        outage['notified'] = True
        save('outage', outage)
    print('OUTAGE:', outage['cause'], 'since', fmt_time(outage['start']))
else:
    ip_hash = hashlib.sha256(wan['addr4'].encode()).hexdigest()
    old_hash = load('wan-ip')
    ip_changed = old_hash is not None and old_hash != ip_hash
    if outage is not None:
        msg = f"✅ rientrato: {outage['cause']}, {fmt_period(outage['start'], now)} ({fmt_duration(now - outage['start'])})"
        if ip_changed: msg += '; IP pubblico cambiato'
        if notify(msg):
            drop('outage'); save('wan-ip', ip_hash)
    elif ip_changed:
        if notify('🔄 riconnessione PPPoE: IP pubblico cambiato'): save('wan-ip', ip_hash)
    elif old_hash is None:
        save('wan-ip', ip_hash)
    degraded_now = gw.get('status') != 'none'
    degraded = load('degraded')
    if degraded_now and degraded is None:
        txt = f"gateway WAN degradato: {gw.get('status_translated')}, RTT {gw.get('delay')}, perdita {gw.get('loss')}"
        if notify('⚠️ ' + txt): save('degraded', txt)
    elif not degraded_now and degraded is not None:
        if notify('✅ rientrato: ' + degraded): drop('degraded')
    print(f"ok: gateway {gw.get('status_translated')}, RTT {gw.get('delay')}, loss {gw.get('loss')}, WAN {wan.get('status')}")
